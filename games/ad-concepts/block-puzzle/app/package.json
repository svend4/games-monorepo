{
  "name": "block-surge",
  "private": true,
  "version": "0.1.0",
  "description": "Block Surge — прод-порт прототипа на TypeScript + Phaser 3 + Vite (Проход Е)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --port 5174 --strictPort"
  },
  "dependencies": {
    "phaser": "^3.85.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
